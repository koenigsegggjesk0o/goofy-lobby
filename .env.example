# ==============================================================
# CONTOH ENVIRONMENT VARIABLES — copy jadi .env lalu isi nilainya.
# JANGAN pernah commit .env yang berisi nilai asli.
#
# Konvensi prefix (keharusan Vite):
#   VITE_*     = diekspos ke browser via import.meta.env — HANYA untuk
#                nilai yang memang publik/aman.
#   tanpa prefix = hanya untuk script/CI server-side — tidak pernah masuk
#                bundle klien. JANGAN memberi prefix VITE_ pada secret.
# ==============================================================

# --- KLIEN (publik/aman terekspos) ---

# Project URL Supabase — Dashboard Supabase → Settings → API → Project URL
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# anon/public key Supabase — Dashboard → Settings → API → anon public
# (dashboard baru menyebutnya "publishable"). Aman untuk klien; keamanan
# data dijaga oleh RLS.
VITE_SUPABASE_ANON_KEY=eyJ...

# Sitekey Turnstile (publik) — Cloudflare Dashboard → Turnstile → widget
# Anda → Site Key. Hostname widget harus mencakup domain/host yang
# memakai widget (tambahkan `localhost` untuk dev lokal).
VITE_TURNSTILE_SITE_KEY=0x...

# Sentry DSN — sentry.io → Settings → Projects → [project] → Client Keys (DSN).
# Aman untuk klien (hanya untuk mengirim error).
VITE_SENTRY_DSN=https://...@oXXXXX.ingest.sentry.io/XXXXXXX

# --- SERVER / SCRIPT SAJA (RAHASIA — jangan pernah prefix VITE_) ---

# service_role key Supabase — BYPASS RLS. Hanya untuk script admin lokal
# (mis. membuat test users) dan tidak boleh masuk bundle klien.
# Dashboard → Settings → API → service_role (dashboard baru: "secret").
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Token level AKUN Supabase (untuk Management API — dipakai workflow
# keepalive GitHub Actions). Dibuat di:
# supabase.com/dashboard/account/tokens → Generate new token.
SUPABASE_ACCESS_TOKEN=sbp_...

# Secret key Turnstile — dipasang di konfigurasi captcha Supabase Auth
# (Authentication → Sign In / Up → Security → Captcha).
TURNSTILE_SECRET_KEY=0x...

# --- OPSIONAL (Fase 2: TURN fallback — Open Relay by Metered, 20GB/bln) ---
# TURN_URL=turn:standard.relay.metered.ca:80
# TURN_USERNAME=...
# TURN_CREDENTIAL=...
