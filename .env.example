# ==============================================================
# CONTOH ENVIRONMENT VARIABLES — copy jadi .env lalu isi nilainya.
# JANGAN pernah commit .env yang berisi nilai asli.
#
# Konvensi prefix (keharusan Vite):
#   VITE_*     = diekspos ke browser via import.meta.env — HANYA untuk
#                nilai yang memang publik/aman.
#   tanpa prefix = hanya untuk script/CI server-side — tidak pernah masuk
#                bundle klien. JANGAN memberi prefix VITE_ pada secret.
# ==============================================================

# --- KLIEN (publik/aman terekspos) ---

# Project URL Supabase — Dashboard Supabase → Settings → API → Project URL
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# anon/public key Supabase — Dashboard → Settings → API → anon public
# (dashboard baru menyebutnya "publishable"). Aman untuk klien; keamanan
# data dijaga oleh RLS.
VITE_SUPABASE_ANON_KEY=eyJ...

# Sitekey Turnstile (publik) — Cloudflare Dashboard → Turnstile → widget
# Anda → Site Key. Hostname widget harus mencakup domain/host yang
# memakai widget (tambahkan `localhost` untuk dev lokal).
VITE_TURNSTILE_SITE_KEY=0x...

# Sentry DSN — sentry.io → Settings → Projects → [project] → Client Keys (DSN).
# Aman untuk klien (hanya untuk mengirim error).
VITE_SENTRY_DSN=https://...@oXXXXX.ingest.sentry.io/XXXXXXX

# --- SERVER / SCRIPT SAJA (RAHASIA — jangan pernah prefix VITE_) ---

# service_role key Supabase — BYPASS RLS. Hanya untuk script admin lokal
# (mis. membuat test users) dan tidak boleh masuk bundle klien.
# Dashboard → Settings → API → service_role (dashboard baru: "secret").
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Token level AKUN Supabase (untuk Management API — dipakai workflow
# keepalive GitHub Actions + scripts/db/apply-migrations.mjs). Dibuat di:
# supabase.com/dashboard/account/tokens → Generate new token.
# HARUS punya scope tulis database (database_migrations_write).
SUPABASE_ACCESS_TOKEN=sbp_...

# Project ref Supabase (bagian subdomain dari Project URL) — dipakai
# script migrasi lokal. Bukan rahasia.
SUPABASE_PROJECT_REF=your-project-ref

# Secret key Turnstile — dipasang di konfigurasi captcha Supabase Auth
# (Authentication → Sign In / Up → Security → Captcha).
TURNSTILE_SECRET_KEY=0x...

# --- OPSIONAL (Fase 2: TURN fallback — Open Relay by Metered, 20GB/bln) ---
# Kenapa namanya kini berprefix VITE_ (semula tanpa prefix): RTCPeerConnection
# berjalan DI BROWSER, jadi kredensial TURN statis memang harus sampai ke
# bundle klien — tanpa prefix VITE_ nilainya tak pernah terekspos dan TURN
# tidak akan pernah aktif. Konsekuensi jujur: username/credential statis
# selalu terlihat di devtools — ini praktik standar WebRTC untuk kredensial
# TURN statis; kredensial dapat dicabut kapan saja dari dashboard Metered.
# Opsi produksi yang lebih aman = kredensial ephemeral via backend (dicatat
# sebagai opsi masa depan, di luar cakupan sekarang).
# VITE_TURN_URL menerima beberapa URL dipisah koma (turn: atau turns:).
# Biarkan berkomentar bila tidak memakai TURN — mesh jatuh ke STUN saja.
# VITE_TURN_URL=turn:standard.relay.metered.ca:80
# VITE_TURN_USERNAME=...
# VITE_TURN_CREDENTIAL=...

# --- OPSIONAL (QA lokal — kredensial test users untuk Playwright/harness) ---
# Dibuat via admin API (email_confirm=true); simpan hanya di .env lokal.
# TEST_USER_ALPHA_EMAIL=qa.alpha@goofy.example.com
# TEST_USER_ALPHA_PASSWORD=...
# TEST_USER_BRAVO_EMAIL=qa.bravo@goofy.example.com
# TEST_USER_BRAVO_PASSWORD=...
# TEST_USER_CHARLIE_EMAIL=qa.charlie@goofy.example.com
# TEST_USER_CHARLIE_PASSWORD=...
